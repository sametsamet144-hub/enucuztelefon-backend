# Backend Environment Variables (.env)

# PostgreSQL Configuration
POSTGRES_DB=enucuztelefon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# If setting a full connection string directly:
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=enucuztelefon;Username=postgres;Password=postgres

# Redis Configuration
ConnectionStrings__Redis=redis:6379,abortConnect=false

# RabbitMQ Configuration
RabbitMQ__HostName=rabbitmq
RabbitMQ__UserName=guest
RabbitMQ__Password=guest

# JWT Authentication
Jwt__SecretKey=EnUcuzTelefonSuperSecretKey2026!MustBe32CharsLongAtLeast
Jwt__Issuer=EnUcuzTelefon
Jwt__Audience=EnUcuzTelefonApp

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production
PORT=5000
